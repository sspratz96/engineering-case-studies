<mxfile host="app.diagrams.net"><diagram name="Governed AI Access Path" id="ai-access-architecture"><mxGraphModel dx="1240" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="740" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Governed AI Access Path" style="text;html=1;align=center;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1240" height="40" as="geometry"/></mxCell><mxCell id="band0" value="AI CLIENTS" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="96" width="1192" height="124" as="geometry"/></mxCell><mxCell id="band1" value="ACCESS LAYER" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="240" width="1192" height="148" as="geometry"/></mxCell><mxCell id="band2" value="DATA LAYER" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="408" width="1192" height="148" as="geometry"/></mxCell><mxCell id="band3" value="CLOSED PATHS" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="576" width="1192" height="112" as="geometry"/></mxCell><mxCell id="claude" value="&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;organization connector&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="360" height="68" as="geometry"/></mxCell><mxCell id="gpt" value="&lt;b&gt;ChatGPT&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;enterprise app, added by admin&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="132" width="360" height="68" as="geometry"/></mxCell><mxCell id="ide" value="&lt;b&gt;IDE and CLI clients&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;any MCP-compatible client&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="840" y="132" width="360" height="68" as="geometry"/></mxCell><mxCell id="idp" value="&lt;b&gt;Company identity provider&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;company accounts only&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;internal consent · read-only scope&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="320" height="92" as="geometry"/></mxCell><mxCell id="mcp" value="&lt;b&gt;MCP server on Cloud Run&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;5 tools · results capped at 500 rows&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;runtime account has no data access&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="276" width="360" height="92" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;OAuth client secret&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;token signing key&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="880" y="276" width="320" height="92" as="geometry"/></mxCell><mxCell id="logs" value="&lt;b&gt;Audit logs&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;every query attributed&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;to the real user&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="320" height="92" as="geometry"/></mxCell><mxCell id="bq" value="&lt;b&gt;BigQuery API&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;runs with the user&amp;#x27;s own token&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;writes rejected · 1 GB cap per query&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="444" width="360" height="92" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;Warehouse datasets&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;visibility = the user&amp;#x27;s own IAM&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;across three projects&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="880" y="444" width="320" height="92" as="geometry"/></mxCell><mxCell id="closed" value="&lt;b&gt;Disabled together with IT&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;official BigQuery connector in AI platforms · direct AI-vendor OAuth access to Google Cloud&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="1160" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="claude" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gpt" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ide" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcp" target="idp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="user token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcp" target="bq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq" target="ds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4b5563;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#4b5563;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bq" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foot" value="Writes are rejected by Google&#x27;s API because the token itself cannot write, not by application code." style="text;html=1;align=center;fontFamily=Arial;fontSize=13;fontStyle=2;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="0" y="704" width="1240" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>