<mxfile host="app.diagrams.net"><diagram name="Explainability Method" id="method-pipeline"><mxGraphModel dx="1240" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="680" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Explainability Method" style="text;html=1;align=center;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="0" y="30" width="1240" height="40" as="geometry"/></mxCell><mxCell id="band0" value="TRAINING" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="96" width="1192" height="124" as="geometry"/></mxCell><mxCell id="band1" value="LOSS" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="236" width="1192" height="124" as="geometry"/></mxCell><mxCell id="band2" value="EXPLANATION, AFTER TRAINING" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="376" width="1192" height="124" as="geometry"/></mxCell><mxCell id="band3" value="EVALUATION" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcfcfd;strokeColor=#e5e7eb;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#4b5563;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="24" y="516" width="1192" height="100" as="geometry"/></mxCell><mxCell id="img" value="&lt;b&gt;Face image&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;121,344 train · 35,328 test&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;balanced real / fake&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="260" height="72" as="geometry"/></mxCell><mxCell id="bil" value="&lt;b&gt;Bilateral filter&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;optional preprocessing&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;benchmark from prior work&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="340" y="132" width="240" height="72" as="geometry"/></mxCell><mxCell id="emb" value="&lt;b&gt;Patch embedding&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;convolutional layer&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;feature maps exposed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="132" width="260" height="72" as="geometry"/></mxCell><mxCell id="vit" value="&lt;b&gt;ViT-B/16&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;implemented from scratch&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;real / fake classifier&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="920" y="132" width="280" height="72" as="geometry"/></mxCell><mxCell id="clf" value="&lt;b&gt;Custom loss on embedding feature maps&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;01 bilateral benchmark · 02 FFT high-frequency · 03 entropy&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="340" y="272" width="540" height="72" as="geometry"/></mxCell><mxCell id="tot" value="&lt;b&gt;Total loss&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;cross-entropy + α · custom loss&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;α from 1e-6 to 1e-2&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="920" y="272" width="280" height="72" as="geometry"/></mxCell><mxCell id="roll" value="&lt;b&gt;Attention rollout&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;head fusion: min, mean, max&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" parent="1"><mxGeometry x="620" y="412" width="260" height="72" as="geometry"/></mxCell><mxCell id="amm" value="&lt;b&gt;Activation maximization&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;discard least relevant&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#4b5563&#x27; style=&#x27;font-size:12px&#x27;&gt;0% to 80%&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d4d7dd;fontFamily=Arial;fontSize=14;fontColor=#1f2328;shadow=1;" vertex="1" p